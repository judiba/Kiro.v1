{
  "enabled": true,
  "name": "Block Hardcoded Secrets",
  "description": "Revisa todas as operações de escrita antes da execução para garantir que não contenham credenciais hardcoded, chaves de API, tokens, senhas ou dados sensíveis. Se encontrar, bloqueia a operação.",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Revise o conteúdo desta operação de escrita. Verifique se contém credenciais hardcoded, chaves de API, tokens, senhas, secrets, connection strings ou qualquer dado sensível. Procure por padrões como: variáveis com valores que parecem ser API keys (strings longas alfanuméricas), passwords em texto plano, tokens JWT hardcoded, connection strings com credenciais, AWS access keys, private keys, ou qualquer outro segredo. Se encontrar dados sensíveis, responda com \"ACCESS DENIED: Operação bloqueada - foram detectadas credenciais/dados sensíveis hardcoded no conteúdo. Use variáveis de ambiente ou um gerenciador de secrets.\" Se NÃO encontrar dados sensíveis, responda com \"Nenhuma credencial hardcoded detectada. Operação permitida.\""
  }
}